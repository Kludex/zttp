#!/bin/sh -e

# Create the virtual environment and install the dev + bench dependency groups.
# `uv sync` builds the Zig extension through the hatchling build hook, so no
# separate compile step is needed - it just needs `zig` on PATH.

if [ -z "$GITHUB_ACTIONS" ]; then
    set -x
    # Local builds default to Debug for symbolized panics and debuggable cores;
    # CI and release wheels keep the pyproject default (stripped ReleaseSafe).
    export HATCH_ZIG_BUILD_MODE="${HATCH_ZIG_BUILD_MODE:-Debug}"
fi

uv sync --all-groups
