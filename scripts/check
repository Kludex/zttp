#!/bin/sh -e

# Run every read-only check the CI enforces: formatting, types, and linting -
# for both the Python package and the Zig core.

export SOURCE_FILES="zttp tests bench.py"

set -x

# Python.
uv run --no-sync ruff format --check --diff $SOURCE_FILES
uv run --no-sync mypy zttp
uv run --no-sync ruff check $SOURCE_FILES

# Zig.
zig fmt --check src build.zig
