#!/bin/sh -e

# Compile the Zig core, the CPython extension, and the documentation site.

set -x

# Pure-Zig core unit tests double as the core's build check.
zig build test

# Build the extension (via the hatchling hook) and confirm it imports. `uv sync`
# resolves the venv interpreter on every OS, so this works on Windows too.
uv sync --all-groups
uv run --no-sync python -c "import zttp; print(zttp.Connection(zttp.SERVER))"

# Build the docs so a broken site fails CI before it ever ships.
uv run --no-sync python -m zensical build
